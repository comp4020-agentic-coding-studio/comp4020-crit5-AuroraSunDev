---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DesertBird</title>
    <meta
      name="description"
      content="DesertBird is a small browser game: fly a bird through a desert of cactus gaps, shoot the creatures in your way, and reach the level's target score without touching anything."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      The UI sprites are pixel art, so the canvas text is set in a pixel face
      to match; system sans-serif beside them read as two different games.
      main.ts waits for it to load before drawing, because a canvas falls back
      silently and the miss is invisible.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
    />
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <main>
      <h1 class="visually-hidden">DesertBird</h1>
      <canvas id="game-canvas" width="800" height="600">
        This game needs a browser that can draw to an HTML canvas.
      </canvas>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
